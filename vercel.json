{
  "framework": "vite",
  "buildCommand": "pnpm run build:client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/trpc/(.*)",
      "destination": "https://<your-render-backend-url>/api/trpc/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
